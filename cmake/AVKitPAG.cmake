if (NOT AVKIT_PAG_INCLUDE_DIR AND DEFINED ENV{AVKIT_PAG_INCLUDE_DIR})
    set(AVKIT_PAG_INCLUDE_DIR "$ENV{AVKIT_PAG_INCLUDE_DIR}" CACHE PATH "Directory containing libpag's C++ headers" FORCE)
endif ()
find_path(AVKIT_PAG_INCLUDE_DIR NAMES pag/pag.h DOC "Directory containing libpag's C++ headers")
if (ANDROID)
    set(AVKIT_ANDROID_PAG_AAR "$ENV{AVKIT_ANDROID_PAG_AAR}" CACHE FILEPATH "libpag Android AAR")
endif ()
if (ANDROID AND AVKIT_ANDROID_PAG_AAR)
    file(SHA256 "${AVKIT_ANDROID_PAG_AAR}" avkit_pag_hash)
    set(avkit_pag_android_dir "${CMAKE_CURRENT_BINARY_DIR}/avkit-pag/${avkit_pag_hash}")
    file(MAKE_DIRECTORY "${avkit_pag_android_dir}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${AVKIT_ANDROID_PAG_AAR}")
    set(AVKIT_PAG_LIBRARY "${avkit_pag_android_dir}/jni/${ANDROID_ABI}/libpag.so")
    if (NOT EXISTS "${AVKIT_PAG_LIBRARY}")
        file(ARCHIVE_EXTRACT INPUT "${AVKIT_ANDROID_PAG_AAR}" DESTINATION "${avkit_pag_android_dir}"
                PATTERNS "jni/${ANDROID_ABI}/libpag.so")
    endif ()
else ()
    if (NOT AVKIT_PAG_LIBRARY AND DEFINED ENV{AVKIT_PAG_LIBRARY})
        set(AVKIT_PAG_LIBRARY "$ENV{AVKIT_PAG_LIBRARY}" CACHE FILEPATH "libpag library for the target platform" FORCE)
    endif ()
    find_library(AVKIT_PAG_LIBRARY NAMES pag libpag DOC "libpag library for the target platform")
endif ()
if (NOT EXISTS "${AVKIT_PAG_INCLUDE_DIR}/pag/pag.h" OR NOT EXISTS "${AVKIT_PAG_LIBRARY}")
    message(FATAL_ERROR "AVKit requires the target libpag SDK. Set AVKIT_PAG_INCLUDE_DIR and AVKIT_PAG_LIBRARY, or supply AVKIT_ANDROID_PAG_AAR on Android.")
endif ()

add_library(avkit_pag_sdk UNKNOWN IMPORTED GLOBAL)
set_target_properties(avkit_pag_sdk PROPERTIES IMPORTED_LOCATION "${AVKIT_PAG_LIBRARY}")

add_library(avkit_pag STATIC
    src/animation/pag_animation.cpp
    src/animation/pag_frame_renderer.cpp
    src/render/pag_overlay_renderer.cpp
)
add_library(AVKit::PAG ALIAS avkit_pag)
target_include_directories(avkit_pag PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_include_directories(avkit_pag SYSTEM PRIVATE "${AVKIT_PAG_INCLUDE_DIR}")
target_link_libraries(avkit_pag PUBLIC AVKit::Core PRIVATE avkit_pag_sdk)
set_target_properties(avkit_pag PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    target_sources(avkit_pag PRIVATE platform/macos/src/pag_transition.mm)
    set_target_properties(avkit_pag PROPERTIES OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON)
    target_compile_options(avkit_pag PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_link_libraries(avkit_pag PRIVATE AVKit::Bgfx "-framework CoreVideo" "-framework OpenGL" "-framework IOSurface")
elseif (ANDROID)
    target_sources(avkit_pag PRIVATE platform/android/src/pag_texture.cpp src/animation/pag_transition_unavailable.cpp)
    target_link_libraries(avkit_pag PRIVATE AVKit::Bgfx EGL GLESv3)
else ()
    target_sources(avkit_pag PRIVATE src/animation/pag_transition_unavailable.cpp)
    target_sources(avkit_pag PRIVATE src/animation/pag_gpu_unavailable.cpp)
endif ()

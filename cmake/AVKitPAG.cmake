find_path(AVKIT_PAG_INCLUDE_DIR NAMES pag/pag.h DOC "Directory containing libpag's C++ headers")
find_library(AVKIT_PAG_LIBRARY NAMES pag libpag DOC "libpag library for the target platform")
if (NOT AVKIT_PAG_INCLUDE_DIR OR NOT AVKIT_PAG_LIBRARY)
    message(FATAL_ERROR "AVKit PAG requires both AVKIT_PAG_INCLUDE_DIR and AVKIT_PAG_LIBRARY")
endif ()

add_library(avkit_pag_sdk UNKNOWN IMPORTED GLOBAL)
set_target_properties(avkit_pag_sdk PROPERTIES IMPORTED_LOCATION "${AVKIT_PAG_LIBRARY}")

add_library(avkit_pag STATIC src/animation/pag_animation.cpp)
add_library(AVKit::PAG ALIAS avkit_pag)
target_include_directories(avkit_pag PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_include_directories(avkit_pag SYSTEM PRIVATE "${AVKIT_PAG_INCLUDE_DIR}")
target_link_libraries(avkit_pag PUBLIC AVKit::Core PRIVATE avkit_pag_sdk)
set_target_properties(avkit_pag PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    target_sources(avkit_pag PRIVATE platform/macos/src/pag_transition.mm)
    set_target_properties(avkit_pag PROPERTIES OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON)
    target_compile_options(avkit_pag PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_link_libraries(avkit_pag PRIVATE AVKit::Bgfx "-framework CoreVideo" "-framework OpenGL" "-framework IOSurface")
else ()
    target_sources(avkit_pag PRIVATE src/animation/pag_transition_unavailable.cpp)
endif ()

# Add Camera integration after the consumer has resolved HuxerUI::Camera.
function(avkit_add_capture_target)
    if (TARGET AVKit::Capture)
        return()
    endif ()
    set(avkit_capture_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    add_library(avkit_capture STATIC "${avkit_capture_root}/src/capture/camera_recording.cpp")
    add_library(AVKit::Capture ALIAS avkit_capture)
    target_include_directories(avkit_capture PRIVATE "${avkit_capture_root}/src")
    target_link_libraries(avkit_capture PUBLIC AVKit::Render AVKit::FFmpeg HuxerUI::Camera)
    set_target_properties(avkit_capture PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)

    if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        target_sources(avkit_capture PRIVATE "${avkit_capture_root}/platform/macos/src/camera_recording.mm")
        target_include_directories(avkit_capture PRIVATE "${avkit_capture_root}/platform/macos/src")
        target_compile_options(avkit_capture PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
        set_target_properties(avkit_capture PROPERTIES
                OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED ON OBJCXX_EXTENSIONS OFF)
        target_link_libraries(avkit_capture PRIVATE "-framework CoreMedia")
    elseif (ANDROID)
        target_sources(avkit_capture PRIVATE "${avkit_capture_root}/platform/android/src/camera_recording.cpp")
        target_include_directories(avkit_capture PRIVATE "${avkit_capture_root}/platform/android/src")
    else ()
        message(FATAL_ERROR "AVKit::Capture currently supports macOS and Android")
    endif ()
endfunction()
